<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ planner.year }} holiday planner</title>
<style>
  :root {
    /* Sheet ---------------------------------------------------------- */
    --page-w: 420mm;            /* A3 landscape */
    --page-h: 297mm;
    --margin: 6mm;
    --header-h: 28mm;
    --url-w: 20mm;              /* the strip holding the URL and the year */
    --month-w: 8mm;             /* the month name bands, left and right */
    --weekday-h: 5.5mm;         /* the Mon..Sun bands, top and bottom */
    --columns: {{ columns }};

    /* Ink ------------------------------------------------------------ */
    --paper: {{ paper }};
    --title-fg: {{ title_ink }};
    --ink: #1b2a4a;
    --band-bg: #1f3f73;
    --band-fg: #ffffff;
    --cell-bg: #f4f5f3;
    --weekend-bg: #cbe0d7;
    --holiday: #c00000;
    --rule: #7f97b8;
    --title-shadow: {{ title_shadow }};

    /* Type ----------------------------------------------------------- */
    --day-size: 7.5pt;
    --label-size: 3.8pt;
    --weekday-size: 6.5pt;
    --month-size: 7pt;
  }

  @page { size: A3 landscape; margin: 0; }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    width: var(--page-w);
    height: var(--page-h);
    font-family: "Liberation Sans", Arial, Helvetica, sans-serif;
    color: var(--ink);
    background: var(--paper);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .sheet {
    width: var(--page-w);
    height: var(--page-h);
    padding: var(--margin);
    display: flex;
    flex-direction: column;
  }

  /* Header ----------------------------------------------------------- */
  .header {
    height: var(--header-h);
    display: flex;
    align-items: flex-start;
    gap: 6mm;
  }
  .logos { display: flex; align-items: flex-start; gap: 3mm; width: 60mm; }
  .logos img { height: 24mm; width: auto; }
  .logos .placeholder {
    height: 24mm;
    width: 34mm;
    border: 0.3mm dashed var(--rule);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 6pt;
    color: var(--rule);
    text-align: center;
  }
  .titles {
    flex: 1;
    text-align: center;
    font-family: "Liberation Serif", "Times New Roman", serif;
    font-style: italic;
    color: var(--title-fg);
    text-shadow: 0 0.3mm 0.4mm var(--title-shadow);
    padding-top: 3mm;
  }
  .titles .org { font-size: 20pt; line-height: 1.25; }
  .titles .centre { font-size: 18pt; line-height: 1.25; }
  .spacer { width: 60mm; }

  /* Body: the vertical URL strip, then the planner ------------------- */
  .body { flex: 1; display: flex; gap: 2mm; min-height: 0; }

  .side {
    width: var(--url-w);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }
  .side .url {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 15pt;
    font-weight: bold;
    color: var(--title-fg);
    text-shadow: 0 0.3mm 0.4mm var(--title-shadow);
    letter-spacing: 0.15mm;
  }
  .side .year {
    font-size: 22pt;
    font-weight: bold;
    color: var(--holiday);
    background: #ffffff;
    padding: 1mm 2mm;
    line-height: 1;
    margin-top: 3mm;
  }

  /* Grid ------------------------------------------------------------- */
  .grid {
    flex: 1;
    display: grid;
    grid-template-columns:
      var(--month-w) repeat(var(--columns), minmax(0, 1fr)) var(--month-w);
    grid-template-rows:
      var(--weekday-h) repeat(12, minmax(0, 1fr)) var(--weekday-h);
    border: 0.5mm solid var(--band-bg);
  }

  .weekday, .month, .corner {
    background: var(--band-bg);
    color: var(--band-fg);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .weekday {
    font-size: var(--weekday-size);
    border-right: 0.15mm solid rgba(255, 255, 255, 0.4);
  }
  .month { font-size: var(--month-size); }
  .month span { writing-mode: vertical-rl; }
  .month.left span { transform: rotate(180deg); }

  .cell {
    background: var(--cell-bg);
    border-right: 0.15mm solid var(--rule);
    border-bottom: 0.15mm solid var(--rule);
    border-top: 0.15mm solid var(--rule);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.3mm 0.5mm;
    overflow: hidden;
  }
  .cell.weekend { background: var(--weekend-bg); }
  .cell.empty { background: transparent; border-color: transparent; }
  .cell.month-start { border-left: 0.3mm solid var(--rule); }

  .cell .top {
    display: flex;
    align-items: baseline;
    gap: 0.3mm;
    width: 100%;
  }
  .num {
    font-size: var(--day-size);
    line-height: 1.1;
  }
  .cell.closed .num { font-weight: bold; }
  .marker {
    font-size: var(--day-size);
    font-weight: bold;
    color: var(--holiday);
    line-height: 1.1;
  }
  .label {
    flex: 1;
    min-height: 0;
    width: 100%;
    margin-top: 0.3mm;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: var(--label-size);
    font-style: italic;
    line-height: 1.15;
    overflow: hidden;
  }

  /* Footnotes -------------------------------------------------------- */
  .footnotes {
    padding-top: 1.2mm;
    padding-left: calc(var(--url-w) + 2mm);
    font-size: 6pt;
    color: var(--ink);
    display: flex;
    gap: 6mm;
    flex-wrap: wrap;
  }
</style>
</head>
<body>
<div class="sheet">

  <header class="header">
    <div class="logos">
      {%- if logos %}
        {%- for logo in logos %}
      <img src="{{ logo }}" alt="">
        {%- endfor %}
      {%- else %}
      <div class="placeholder">logo</div>
      {%- endif %}
    </div>
    <div class="titles">
      <div class="org">{{ planner.header.organization }}</div>
      <div class="centre">{{ planner.header.centre }}</div>
    </div>
    <div class="spacer"></div>
  </header>

  <div class="body">
    <div class="side">
      <div class="url">{{ planner.header.url }}</div>
      <div class="year">{{ planner.year }}</div>
    </div>

    <div class="grid">
      <div class="corner"></div>
      {%- for name in weekdays %}
      <div class="weekday">{{ name }}</div>
      {%- endfor %}
      <div class="corner"></div>

      {%- for row in rows %}
      <div class="month left"><span>{{ months[loop.index0] }}</span></div>
        {%- for cell in row %}
        <div class="cell{{ ' empty' if not cell.filled }}{{ ' weekend' if cell.filled and cell.weekend }}{{ ' closed' if cell.closed }}{{ ' month-start' if cell.filled and cell.date.day == 1 }}">
          {%- if cell.filled %}
          <div class="top"><span class="num">{{ cell.date.day }}</span><span class="marker">{{ cell.marker }}</span></div>
            {%- if cell.label %}
          <div class="label">{{ cell.label }}{% if cell.qualifier %}<br>{{ cell.qualifier }}{% endif %}</div>
            {%- endif %}
          {%- endif %}
        </div>
        {%- endfor %}
      <div class="month right"><span>{{ months[loop.index0] }}</span></div>
      {%- endfor %}

      <div class="corner"></div>
      {%- for name in weekdays %}
      <div class="weekday">{{ name }}</div>
      {%- endfor %}
      <div class="corner"></div>
    </div>
  </div>

  {%- if planner.footnotes %}
  <div class="footnotes">
    {%- for note in planner.footnotes %}
    <span>{{ note }}</span>
    {%- endfor %}
  </div>
  {%- endif %}

</div>
</body>
</html>
